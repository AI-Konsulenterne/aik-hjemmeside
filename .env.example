# Strapi CMS
STRAPI_API_URL=
STRAPI_API_TOKEN=

# Revalidate webhook secret (for Strapi → Next.js on-demand ISR)
REVALIDATE_SECRET=

# Google Analytics
NEXT_PUBLIC_GA_ID=

# Optional OpenAI Ads Pixel — leave blank until the source/event are configured.
# Requires marketing consent; read CONVERSION-SETUP.md before enabling.
NEXT_PUBLIC_OPENAI_PIXEL_ID=

# Contact enquiries — reuse the existing Resend service for AI analysis emails.
# Keep the key server-side and use a sender verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="AI Konsulenterne <analyse@ai-konsulenterne.dk>"
ALEXANDER_EMAIL=alexander@ai-konsulenterne.dk

# Cookiebot
NEXT_PUBLIC_COOKIEBOT_ID=

# ActiveCampaign — Lead magnet (gratis AI-guide)
# API URL format: https://<dit-account>.api-us1.com
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_KEY=
# List ID som kontakter tilføjes til (triggerer automation der sender PDF)
ACTIVECAMPAIGN_LIST_ID=
# Tag der tilføjes til kontakter fra lead magnet (til segmentering)
ACTIVECAMPAIGN_TAG=ai-guide-download

# Cal.com
NEXT_PUBLIC_CAL_USERNAME=
NEXT_PUBLIC_CAL_ORIGIN=https://app.cal.com
NEXT_PUBLIC_CAL_EMBED_URL=https://app.cal.com/embed/embed.js
